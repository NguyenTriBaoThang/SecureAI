# ==============================================================================
# SecureAI Environment Configuration Template
# Sao chép file này thành .env trước khi khởi chạy hệ thống: cp .env.example .env
# ==============================================================================

# Database Settings (Microsoft SQL Server)
MSSQL_SA_PASSWORD=SecureAI@2026StrongPass!
DB_HOST=db
DB_PORT=1433
DB_NAME=SecureAI_DB
DB_USER=sa

# Backend ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:7124
JWT_SECRET=SECUREAI_SUPER_SECRET_KEY_FOR_LOCAL_DEVELOPMENT_ONLY_AT_LEAST_64_CHARS_LONG_2026!
JWT_ISSUER=SecureAI
JWT_AUDIENCE=SecureAI-Client
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7

# AI Engine (FastAPI + PyTorch)
ML_API_BASE_URL=http://ai_server:8000
AI_PORT=8000
MODEL_PATH=model/Attention_BiLSTM.pt

# Frontend React 18 + Vite Settings
VITE_API_BASE_URL=http://localhost:7124/api
VITE_ML_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
